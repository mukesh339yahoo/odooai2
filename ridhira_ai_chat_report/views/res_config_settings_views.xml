<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ridhira.ai.chat.report</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Chat Report" string="AI Chat Report" name="ridhira_ai_chat_report" groups="base.group_system">
                    <block title="AI Engine &amp; Provider Configuration" name="ai_provider_settings">
                        <setting string="AI Provider" help="Select which AI engine powers natural language reports">
                            <field name="ridhira_llm_provider" widget="radio"/>
                        </setting>

                        <!-- Google Gemini -->
                        <setting string="Google Gemini Configuration" help="Fast inference and generous free tier" invisible="ridhira_llm_provider != 'gemini'">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="ridhira_gemini_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_gemini_api_key" password="True" placeholder="AIzaSy..."/>
                                </div>
                                <div class="row mt-2">
                                    <label for="ridhira_gemini_model" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_gemini_model"/>
                                </div>
                            </div>
                        </setting>

                        <!-- OpenAI -->
                        <setting string="OpenAI Configuration" help="Leading reasoning models from OpenAI" invisible="ridhira_llm_provider != 'openai'">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="ridhira_openai_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_openai_api_key" password="True" placeholder="sk-..."/>
                                </div>
                                <div class="row mt-2">
                                    <label for="ridhira_openai_model" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_openai_model"/>
                                </div>
                            </div>
                        </setting>

                        <!-- Anthropic -->
                        <setting string="Anthropic Claude Configuration" help="State of the art intelligence with Claude 3.5" invisible="ridhira_llm_provider != 'anthropic'">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="ridhira_anthropic_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_anthropic_api_key" password="True" placeholder="sk-ant-..."/>
                                </div>
                                <div class="row mt-2">
                                    <label for="ridhira_anthropic_model" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_anthropic_model"/>
                                </div>
                            </div>
                        </setting>

                        <!-- Groq -->
                        <setting string="Groq Ultra-Fast Inference" help="High-speed inference on LPU chips (sub-second queries)" invisible="ridhira_llm_provider != 'groq'">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="ridhira_groq_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_groq_api_key" password="True" placeholder="gsk_..."/>
                                </div>
                                <div class="row mt-2">
                                    <label for="ridhira_groq_model" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_groq_model"/>
                                </div>
                            </div>
                        </setting>

                        <!-- Ollama Local -->
                        <setting string="Ollama (Local / On-Premise)" help="100% private, on-premise execution with no external API calls" invisible="ridhira_llm_provider != 'ollama'">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="ridhira_ollama_endpoint" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_ollama_endpoint" placeholder="http://localhost:11434"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="ridhira_ollama_model" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_ollama_model" placeholder="llama3.2"/>
                                </div>
                            </div>
                        </setting>

                        <!-- Custom Endpoint -->
                        <setting string="Custom OpenAI-Compatible Endpoint" help="Connect to DeepSeek, OpenRouter, vLLM, Azure, etc." invisible="ridhira_llm_provider != 'custom'">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="ridhira_custom_endpoint" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_custom_endpoint" placeholder="https://api.deepseek.com/v1"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="ridhira_custom_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_custom_api_key" password="True"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="ridhira_custom_model" class="col-lg-3 o_light_label"/>
                                    <field name="ridhira_custom_model" placeholder="deepseek-chat"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Advanced Features" name="ai_advanced_features">
                        <setting string="Executive AI Insights" help="Automatically generate key business takeaways and trends alongside visual reports">
                            <field name="ridhira_enable_ai_insights"/>
                        </setting>
                        <setting string="Voice Speech-to-Text" help="Allow dictating query prompts using microphone directly in the UI">
                            <field name="ridhira_enable_voice_input"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    
    <record id="action_ai_chat_report_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'ridhira_ai_chat_report', 'bin_size': False}</field>
    </record>
</odoo>
