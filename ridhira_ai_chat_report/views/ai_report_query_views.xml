<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ai.report.query List View -->
    <record id="view_ai_report_query_list" model="ir.ui.view">
        <field name="name">ai.report.query.list</field>
        <field name="model">ai.report.query</field>
        <field name="arch" type="xml">
            <list string="AI Query History">
                <field name="create_date" string="Date"/>
                <field name="name" string="Query"/>
                <field name="model_name" string="Target Model"/>
                <field name="chart_type" widget="badge" decoration-info="chart_type == 'bar'" decoration-success="chart_type == 'pie'" decoration-warning="chart_type == 'line'" decoration-primary="chart_type == 'pivot'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <button name="action_open_report" string="View Report" type="object" icon="fa-area-chart" class="btn btn-sm btn-primary"/>
            </list>
        </field>
    </record>

    <!-- ai.report.query Form View -->
    <record id="view_ai_report_query_form" model="ir.ui.view">
        <field name="name">ai.report.query.form</field>
        <field name="model">ai.report.query</field>
        <field name="arch" type="xml">
            <form string="AI Query Details">
                <header>
                    <button name="action_open_report" string="Launch Report / Chart" type="object" class="btn btn-primary" icon="fa-play"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Query Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sales by Partner in Bar Chart"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Query Context">
                            <field name="user_prompt"/>
                            <field name="model_name"/>
                            <field name="chart_type"/>
                            <field name="measure"/>
                        </group>
                        <group string="User &amp; Execution">
                            <field name="user_id"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="ORM Parameters" name="orm_params">
                            <group>
                                <field name="domain" widget="ace" options="{'mode': 'json'}"/>
                                <field name="groupby"/>
                                <field name="fields_list"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ai.report.query Search View -->
    <record id="view_ai_report_query_search" model="ir.ui.view">
        <field name="name">ai.report.query.search</field>
        <field name="model">ai.report.query</field>
        <field name="arch" type="xml">
            <search string="Search AI Queries">
                <field name="name" string="Query"/>
                <field name="model_name" string="Model"/>
                <field name="user_id"/>
                <filter name="my_queries" string="My Queries" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="type_bar" string="Bar Charts" domain="[('chart_type', '=', 'bar')]"/>
                <filter name="type_pie" string="Pie Charts" domain="[('chart_type', '=', 'pie')]"/>
                <filter name="type_line" string="Line Charts" domain="[('chart_type', '=', 'line')]"/>
                <filter name="type_pivot" string="Pivot Tables" domain="[('chart_type', '=', 'pivot')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_model" string="Model" domain="[]" context="{'group_by': 'model_name'}"/>
                    <filter name="group_by_chart_type" string="Chart Type" domain="[]" context="{'group_by': 'chart_type'}"/>
                    <filter name="group_by_user" string="User" domain="[]" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for History -->
    <record id="action_ai_report_query_history" model="ir.actions.act_window">
        <field name="name">Query History</field>
        <field name="res_model">ai.report.query</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_report_query_search"/>
        <field name="context">{'search_default_my_queries': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI queries generated yet!
            </p>
            <p>
                Use the AI Query Bar in the top navigation or Dashboard to generate dynamic reports and pivot tables.
            </p>
        </field>
    </record>
</odoo>
