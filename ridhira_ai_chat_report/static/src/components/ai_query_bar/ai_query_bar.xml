<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Systray AI Query Bar Component -->
    <t t-name="ridhira_ai_chat_report.AiQueryBar">
        <div class="o_ai_chat_report_systray d-flex align-items-center">
            <button class="btn btn-sm btn-link d-flex align-items-center p-2 border-0 shadow-none"
                    t-on-click="togglePanel"
                    title="AI Data Analyst (Odoo 20)">
                <i class="fa fa-magic fa-lg text-primary o_ai_wand_icon" role="img" aria-label="AI Analyst"/>
            </button>
            
            <div t-if="state.isOpen" class="o_ai_chat_panel dropdown-menu show shadow-lg border-0 rounded-4 p-3 animate__animated animate__fadeIn" t-on-click.stop="">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0 text-primary fw-bold d-flex align-items-center">
                        <i class="fa fa-magic me-2"/> AI Data Analyst
                    </h6>
                    <button class="btn-close btn-close-sm" t-on-click="closePanel" title="Close"/>
                </div>
                
                <p class="text-muted small mb-3">Ask questions in plain English to build instant charts &amp; pivot tables.</p>
                
                <!-- Suggestions Chips -->
                <div class="o_ai_suggestions mb-2 d-flex flex-wrap gap-1">
                    <t t-foreach="suggestions" t-as="sug" t-key="sug">
                        <button type="button" class="badge rounded-pill o_ai_chip border-0 text-truncate" 
                                t-on-click="() => this.setPrompt(sug)"
                                t-att-title="sug">
                            <i class="fa fa-lightbulb-o me-1"/> <t t-esc="sug"/>
                        </button>
                    </t>
                </div>

                <div class="mb-3 position-relative">
                    <textarea 
                        class="form-control o_ai_textarea p-2" 
                        t-model="state.prompt" 
                        t-on-keydown="onKeydown"
                        placeholder="e.g., Show me monthly sales by salesperson as a bar chart..." 
                        rows="3"
                        t-att-disabled="state.isLoading">
                    </textarea>
                </div>
                
                <div t-if="state.error" class="alert alert-danger p-2 small mb-3 rounded-3">
                    <i class="fa fa-exclamation-triangle me-1"/> <t t-esc="state.error"/>
                </div>
                
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted extra-small">Press Enter ↵ to generate</span>
                    <button class="btn btn-primary btn-sm px-3 d-flex align-items-center rounded-pill shadow-sm" 
                            t-on-click="submitQuery" 
                            t-att-disabled="state.isLoading || !state.prompt">
                        <t t-if="state.isLoading">
                            <i class="fa fa-circle-o-notch fa-spin me-2"/> Analyzing...
                        </t>
                        <t t-else="">
                            Generate Report <i class="fa fa-arrow-right ms-2"/>
                        </t>
                    </button>
                </div>
            </div>
        </div>
    </t>

    <!-- Full Dashboard Client Action Component -->
    <t t-name="ridhira_ai_chat_report.AiReportDashboard">
        <div class="o_ai_report_dashboard h-100 overflow-auto p-4 p-md-5">
            <div class="container-fluid max-w-1200 mx-auto">
                <!-- Header / Banner -->
                <div class="o_ai_dashboard_header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 p-4 rounded-4 shadow-sm">
                    <div>
                        <div class="d-inline-flex align-items-center badge bg-primary-subtle text-primary mb-2 px-3 py-2 rounded-pill fw-semibold">
                            <i class="fa fa-sparkles me-2"/> Odoo 20 AI Analytics Engine
                        </div>
                        <h2 class="fw-bold mb-1">AI Chat-to-Report &amp; Dashboard Assistant</h2>
                        <p class="text-muted mb-0">Transform natural language into real-time business intelligence, interactive charts, and pivot tables.</p>
                    </div>
                    <div class="mt-3 mt-md-0 d-flex gap-2">
                        <button class="btn btn-outline-secondary rounded-pill px-3" t-on-click="openHistory">
                            <i class="fa fa-history me-1"/> Query History
                        </button>
                        <button class="btn btn-outline-primary rounded-pill px-3" t-on-click="openSettings">
                            <i class="fa fa-cog me-1"/> Settings
                        </button>
                    </div>
                </div>

                <!-- Main Query Input Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 o_ai_query_card">
                    <div class="d-flex align-items-center mb-3">
                        <div class="o_ai_badge_icon rounded-circle d-flex align-items-center justify-content-center me-3 text-white">
                            <i class="fa fa-magic fa-lg"/>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Ask Your Business Intelligence Assistant</h5>
                            <span class="text-muted small">Type any query across Sales, Accounting, Inventory, CRM, or Custom models.</span>
                        </div>
                    </div>

                    <div class="mb-3 position-relative">
                        <textarea 
                            class="form-control o_ai_main_textarea p-3 fs-5" 
                            t-model="state.prompt" 
                            t-on-keydown="onKeydown"
                            placeholder="e.g., Show me monthly revenue grouped by partner for the last 6 months in a line chart..." 
                            rows="3"
                            t-att-disabled="state.isLoading">
                        </textarea>
                    </div>

                    <div t-if="state.error" class="alert alert-danger p-3 rounded-3 mb-3">
                        <i class="fa fa-exclamation-circle me-2"/> <t t-esc="state.error"/>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                        <div class="text-muted small">
                            <i class="fa fa-shield me-1 text-success"/> Data remains strictly inside your server. Only schema definitions are consulted.
                        </div>
                        <button class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow d-flex align-items-center justify-content-center" 
                                t-on-click="submitQuery" 
                                t-att-disabled="state.isLoading || !state.prompt">
                            <t t-if="state.isLoading">
                                <i class="fa fa-circle-o-notch fa-spin me-2"/> Generating AI Report...
                            </t>
                            <t t-else="">
                                <i class="fa fa-bolt me-2"/> Generate Visual Report
                            </t>
                        </button>
                    </div>
                </div>

                <!-- Presets / Quick Discovery Grid -->
                <div class="mb-5">
                    <h5 class="fw-bold mb-3"><i class="fa fa-compass me-2 text-primary"/> Instant Explore Prompts</h5>
                    <div class="row g-3">
                        <t t-foreach="categories" t-as="cat" t-key="cat.title">
                            <div class="col-12 col-md-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 p-3 o_ai_category_card">
                                    <h6 class="fw-bold text-primary mb-3 d-flex align-items-center">
                                        <i t-attf-class="fa #{cat.icon} me-2"/> <t t-esc="cat.title"/>
                                    </h6>
                                    <div class="d-flex flex-column gap-2">
                                        <t t-foreach="cat.queries" t-as="q" t-key="q">
                                            <button class="btn btn-light btn-sm text-start rounded-3 o_ai_preset_btn" 
                                                    t-on-click="() => this.setPrompt(q)">
                                                <i class="fa fa-chevron-right text-muted extra-small me-2"/> <t t-esc="q"/>
                                            </button>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Recent Queries Table / Section -->
                <div t-if="state.recentQueries and state.recentQueries.length" class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0"><i class="fa fa-clock-o me-2 text-primary"/> Recent Queries</h5>
                        <button class="btn btn-sm btn-link text-decoration-none" t-on-click="openHistory">View All →</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Query</th>
                                    <th>Target Model</th>
                                    <th>Chart Type</th>
                                    <th>Created On</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.recentQueries" t-as="rec" t-key="rec.id">
                                    <tr>
                                        <td class="fw-medium"><t t-esc="rec.name"/></td>
                                        <td><code><t t-esc="rec.model_name"/></code></td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill text-uppercase">
                                                <t t-esc="rec.chart_type"/>
                                            </span>
                                        </td>
                                        <td class="text-muted small"><t t-esc="rec.create_date"/></td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-primary rounded-pill px-3" t-on-click="() => this.runRecentQuery(rec)">
                                                <i class="fa fa-play me-1"/> Re-run
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
